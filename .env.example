# Database
DATABASE_URL=postgresql://admin:dev_password@localhost:5432/atria_admission

# Auth
JWT_SECRET=your-super-secret-key-change-this-in-production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=your-refresh-secret-change-this-in-production
REFRESH_TOKEN_EXPIRES_IN=7d

# Supabase (Storage — for document uploads)
# SUPABASE_URL=
